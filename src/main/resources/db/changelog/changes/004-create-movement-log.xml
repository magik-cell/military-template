<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-personnel-movements" author="military-system">
        <comment>Створення журналу операцій з персоналом (audit trail)</comment>
        
        <createTable tableName="personnel_movements">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            
            <column name="personnel_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            
            <column name="from_location" type="VARCHAR(200)"/>
            
            <column name="to_location" type="VARCHAR(200)"/>
            
            <column name="previous_rank" type="VARCHAR(30)"/>
            
            <column name="new_rank" type="VARCHAR(30)"/>
            
            <column name="reason" type="VARCHAR(500)"/>
            
            <column name="notes" type="VARCHAR(500)"/>
            
            <column name="performed_by" type="VARCHAR(100)"/>
            
            <column name="performed_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            
            <column name="effective_date" type="TIMESTAMP"/>
            
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <addForeignKeyConstraint 
            baseTableName="personnel_movements"
            baseColumnNames="personnel_id"
            referencedTableName="personnel"
            referencedColumnNames="id"
            constraintName="fk_movements_personnel"
            onDelete="RESTRICT"/>
        
        <!-- Індекс для пошуку історії конкретного військовослужбовця -->
        <createIndex indexName="idx_movements_personnel" tableName="personnel_movements">
            <column name="personnel_id"/>
        </createIndex>
        
        <!-- Індекс для пошуку по типу операції -->
        <createIndex indexName="idx_movements_type" tableName="personnel_movements">
            <column name="type"/>
        </createIndex>
        
        <!-- Індекс для пошуку по даті виконання (новіші спочатку) -->
        <createIndex indexName="idx_movements_performed_date" tableName="personnel_movements">
            <column name="performed_at" descending="true"/>
        </createIndex>
        
        <!-- Індекс для пошуку по даті набуття чинності -->
        <createIndex indexName="idx_movements_effective_date" tableName="personnel_movements">
            <column name="effective_date"/>
        </createIndex>
        
        <rollback>
            <dropTable tableName="personnel_movements"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
